{
  "name": "@tezkar/api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --test-concurrency=1 --import tsx --test test/*.test.ts",
    "bootstrap": "node --env-file=.env --import tsx src/db/bootstrap-admin.ts",
    "start": "node dist/main.js",
    "migrate": "node --env-file=.env --import tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "fastify": "^5.6.1",
    "pdfkit": "^0.21.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.15.5",
    "eslint": "9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
