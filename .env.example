NODE_ENV=development
DATABASE_URL=postgresql://tezkar:tezkar@localhost:5432/tezkar
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_COOKIE_SAMESITE=lax
DB_POOL_MAX=10
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
# Next.js proxies same-origin /api/* requests to the API.
# In Railway production, use the API service's private Railway address.
API_PROXY_TARGET=http://localhost:4000
