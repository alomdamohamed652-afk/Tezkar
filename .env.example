NODE_ENV=development
DATABASE_URL=postgresql://tezkar:tezkar@localhost:5432/tezkar
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_COOKIE_SAMESITE=lax
DB_POOL_MAX=10
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
# Same-origin mode: leave NEXT_PUBLIC_API_URL empty; Next.js proxies /api/* to API_PROXY_TARGET.
# API_PROXY_TARGET is read at web BUILD time.
API_PROXY_TARGET=http://localhost:4000
NEXT_PUBLIC_API_URL=
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
